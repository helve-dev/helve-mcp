{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "helve": {
      "type": "streamable-http",
      "url": "https://helve.dev/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": ["tools:read", "tools:call"]
          }
        }
      }
    }
  }
}

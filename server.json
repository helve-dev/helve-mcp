{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.helve/helve",
  "title": "Helve",
  "description": "Pay-per-call AI tool gateway (313 tools, 255 providers) with spend_limit_usd caps & $0 failed calls",
  "version": "2.0.2",
  "websiteUrl": "https://helve.dev",
  "repository": {
    "url": "https://github.com/helve-dev/helve-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://helve.dev/icon-512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    },
    {
      "src": "https://helve.dev/favicon-48.png",
      "mimeType": "image/png",
      "sizes": ["48x48"]
    },
    {
      "src": "https://helve.dev/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://helve.dev/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer API key from https://helve.dev (format: Bearer sk_live_...)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}

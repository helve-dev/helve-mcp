{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.helve/helve",
  "title": "Helve",
  "description": "0% markup AI tool gateway (324 tools, 257 providers) with spend_limit_usd caps & $0 failed calls",
  "version": "2.0.4",
  "websiteUrl": "https://helve.dev",
  "icons": [
    {
      "src": "https://helve.dev/icon-512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    },
    {
      "src": "https://helve.dev/favicon-48.png",
      "mimeType": "image/png",
      "sizes": ["48x48"]
    },
    {
      "src": "https://helve.dev/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    }
  ],
  "repository": {
    "url": "https://github.com/helve-dev/helve-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://helve.dev/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer API key from https://helve.dev (format: Bearer sk_live_...)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "helve-mcp",
      "version": "2.0.4",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "HELVE_API_KEY",
          "description": "Helve API key from https://helve.dev (format: sk_live_...)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    },
    {
      "registryType": "pypi",
      "identifier": "helve-mcp",
      "version": "2.0.5",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "HELVE_API_KEY",
          "description": "Helve API key from https://helve.dev (format: sk_live_...)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
